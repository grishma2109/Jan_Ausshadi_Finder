rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users Collection ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
               data.uid is string &&
               data.email is string &&
               data.email.size() <= 256;
      }

      allow get: if isSignedIn(); // Allow reading other profiles for search/interaction if needed
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && 
                      isValidUser(incoming()) && 
                      incoming().uid == existing().uid &&
                      incoming().createdAt == existing().createdAt;
      
      // --- Reminders Subcollection ---
      match /reminders/{reminderId} {
        function isValidReminder(data) {
          return data.keys().hasAll(['userId', 'medicineName', 'dosage', 'nextRefillDate', 'isCompleted', 'createdAt']) &&
                 data.userId == request.auth.uid &&
                 data.medicineName is string && data.medicineName.size() <= 200 &&
                 data.dosage is string && data.dosage.size() <= 100;
        }

        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidReminder(incoming());
        allow update: if isOwner(userId) && 
                        isValidReminder(incoming()) && 
                        incoming().createdAt == existing().createdAt &&
                        incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      // --- Search History Subcollection ---
      match /searchHistory/{searchId} {
        function isValidSearch(data) {
          return data.keys().hasAll(['brandName', 'genericName', 'timestamp']) &&
                 data.brandName is string && data.brandName.size() <= 200 &&
                 data.genericName is string && data.genericName.size() <= 200;
        }

        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSearch(incoming());
        allow delete: if isOwner(userId);
      }
    }

    // --- Feedback Collection ---
    match /feedback/{feedbackId} {
      function isValidFeedback(data) {
        return data.keys().hasAll(['name', 'email', 'message', 'userId', 'createdAt']) &&
               data.name is string && data.name.size() <= 100 &&
               data.email is string && data.email.size() <= 256 &&
               data.message is string && data.message.size() <= 2000;
      }

      allow create: if isSignedIn() && isValidFeedback(incoming());
      allow read: if false; // Only admins can read feedback (not implemented in client rules for security)
    }
  }
}
